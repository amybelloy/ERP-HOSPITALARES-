# =====================================================================
# Saúde Gestão — variáveis de ambiente (copie para .env)
# NUNCA versionar o .env real. Certificados ficam fora do repositório.
# =====================================================================
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://hospital:hospital@localhost:5432/hospital_dev

# Modo de demonstração: provedores simulados + botões de simulação. Em produção: false
DEMO_MODE=true

# Sessão
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
COOKIE_SECURE=false            # true atrás de HTTPS (obrigatório em produção)
TRUST_PROXY=                   # ex.: 1 quando atrás de nginx/load balancer
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
LOGIN_RATE_LIMIT=20

# Pagamentos manuais (dinheiro, cartão sem TEF) exigem conferência por outro usuário
MANUAL_PAYMENTS_REQUIRE_CONFERENCE=true

# Senha dos usuários de demonstração criados pelo seed
SEED_PASSWORD=Demo@12345
SEED_DEMO_DATA=true

# ---------------- Pix ----------------
PIX_PROVIDER=DEMO_PIX          # DEMO_PIX | SANTANDER_PIX
PIX_EXPIRATION_SECONDS=3600
PIX_WEBHOOK_SECRET=            # segredo aleatório longo; compõe a URL do webhook cadastrada no banco
PIX_WEBHOOK_REQUIRE_MTLS_HEADER=false
DEMO_WEBHOOK_SECRET=troque-este-segredo-de-demo

# Santander (API Pix padrão BACEN) — confirmar URLs no portal do desenvolvedor Santander
SANTANDER_PIX_BASE_URL=
SANTANDER_PIX_TOKEN_URL=
SANTANDER_CLIENT_ID=
SANTANDER_CLIENT_SECRET=
SANTANDER_CERT_PATH=/run/secrets/santander_cert.pem
SANTANDER_KEY_PATH=/run/secrets/santander_key.pem
SANTANDER_CERT_PASSPHRASE=
SANTANDER_PIX_KEY=

# ---------------- Cartão ----------------
CARD_PROVIDER=DEMO_CARD        # DEMO_CARD | GETNET
CARD_CALLBACK_SECRET=troque-este-segredo
GETNET_BASE_URL=
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_SELLER_ID=
GETNET_TERMINAL_ID=

# ---------------- Fiscal (NFS-e) ----------------
FISCAL_PROVIDER=DEMO_FISCAL    # DEMO_FISCAL | NFSE_NACIONAL
NFSE_NACIONAL_BASE_URL=
NFSE_CERT_PATH=/run/secrets/certificado_a1.pfx
NFSE_CERT_PASSPHRASE=
NFSE_AMBIENTE=2                # 1 = produção, 2 = produção restrita (homologação)
