{
  "name": "saude-gestao-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend do sistema de gestão hospitalar (atendimento, conta, recebimento, quitação automática, fiscal e conciliação)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "node src/db/migrate.js && node src/db/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  }
}
